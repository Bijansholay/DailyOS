PORT=3001
NODE_ENV=development
# Allowed origins for CORS (comma-separated, e.g. http://localhost:5173,https://myapp.com)
CLIENT_URL=

# Database Settings (Optional: leave empty to use zero-config local SQLite database engine)
SUPABASE_URL=
SUPABASE_KEY=

# AI Layer Settings (Optional: leave empty to use smart heuristic briefing engine)
GEMINI_API_KEY=

# Authentication JWT Secret (Optional: random secret auto-generated if left empty)
JWT_SECRET=your_jwt_secret_key_here

# Local / Dev Default User ID
DEFAULT_USER_ID=user_000000000000000000000000001

